# Local development (astro dev / astro preview). Copy to .env; never commit real values.
# Production: SUPABASE_URL lives in wrangler.jsonc "vars", SUPABASE_KEY is a Workers secret
# (npx wrangler secret put SUPABASE_KEY). Both are server-only (astro:env/server).
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable/anon key, NOT the service_role/secret key
SUPABASE_KEY=###

# E2E test user (Playwright). Put these in .dev.vars, not .env: playwright.config.ts loads only
# .dev.vars, which must point at the LOCAL Supabase. Optional: E2E_PORT overrides 4321.
E2E_USERNAME=
E2E_PASSWORD=
