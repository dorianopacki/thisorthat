---
import Layout from "@/layouts/Layout.astro";
import { Pencil } from "lucide-react";
import { createClient } from "@/lib/supabase";
import { voteUrl } from "@/lib/study-links";
import { ServerError } from "@/components/auth/ServerError";
import StartStudyButton from "@/components/studies/StartStudyButton";
import LinkList from "@/components/studies/LinkList";
import StudyResults from "@/components/studies/StudyResults";
import CloseStudyButton from "@/components/studies/CloseStudyButton";
import { formatDeadline } from "@/lib/study-deadline";
import { STATUS_LABELS } from "@/lib/study-status";
import { parseStudyResults, type StudyResults as StudyResultsData } from "@/lib/study-results";

// No top-level `return` here: typescript-eslint's no-misused-promises crashes on a return
// outside a function, so a missing study sets the 404 status and renders a short message.
// Results and comments are rendered here: never serve this page from a browser/bfcache copy.
Astro.response.headers.set("Cache-Control", "no-store");

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  throw new Error("Supabase nie jest skonfigurowany.");
}

const id = Astro.params.id ?? "";
const error = Astro.url.searchParams.get("error");

// RLS returns nothing for someone else's study; an id that is not a uuid makes PostgREST
// answer 22P02. Both are a 404 for the author.
const { data: study, error: studyError } = await supabase
  .from("studies")
  .select("id, title, participant_target, status, closes_at, closes_tz")
  .eq("id", id)
  .maybeSingle();

if (studyError && studyError.code !== "22P02") {
  throw new Error("Nie udało się wczytać badania.");
}

let variants: { id: string; position: number; content: string }[] = [];
let results: StudyResultsData | null = null;
let urls: string[] = [];
if (study?.status === "draft") {
  const { data, error: variantsError } = await supabase
    .from("variants")
    .select("id, position, content")
    .eq("study_id", study.id)
    .order("position", { ascending: true });

  if (variantsError) {
    throw new Error("Nie udało się wczytać wariantów badania.");
  }
  variants = data;
} else if (study) {
  // Votes and comments reach the author only as aggregates (docs/reference/contract-surfaces.md#anonymity-rule).
  const { data, error: resultsError } = await supabase.rpc("get_study_results", { p_study_id: study.id });
  if (resultsError) {
    throw new Error("Nie udało się wczytać wyników badania.");
  }
  if (data !== null) {
    results = parseStudyResults(data);
    if (!results) {
      throw new Error("Nie udało się odczytać wyników badania.");
    }
  }

  // Links exist once the study has started. Select only `id, token` — authors never read `used`.
  if (results) {
    const { data: links, error: linksError } = await supabase
      .from("study_links")
      .select("id, token")
      .eq("study_id", study.id)
      .order("id", { ascending: true });

    if (linksError) {
      throw new Error("Nie udało się wczytać linków badania.");
    }
    urls = links.map((link) => voteUrl(Astro.url.origin, link.token));
  }
}

// A null get_study_results after the RLS-filtered read should not happen; treat it as not found.
const shown = study && (study.status === "draft" || results) ? study : null;
if (!shown) {
  Astro.response.status = 404;
}

// studies.status alone can read 'active' past the deadline: started studies take the effective
// status from get_study_results (docs/reference/contract-surfaces.md#closing-rule).
const effectiveStatus = results?.status ?? shown?.status;
const deadline = shown?.closes_at && shown.closes_tz ? formatDeadline(shown.closes_at, shown.closes_tz) : null;
---

<Layout title={shown ? shown.title : "Nie znaleziono badania"}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      {!shown ? (
        <>
          <h1 class="mb-4 text-center text-2xl font-bold">Nie znaleziono badania</h1>
          <p class="text-center text-sm text-blue-100/80">
            <a href="/dashboard" class="text-purple-300 hover:underline">
              Wróć do panelu
            </a>
          </p>
        </>
      ) : (
        <>
          {!results && (
            <p class="mb-2 text-center text-xs tracking-wide text-blue-100/60 uppercase">
              {STATUS_LABELS[shown.status]}
            </p>
          )}
          <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold break-words text-transparent">
            {shown.title}
          </h1>
          <p class="mb-4 text-sm text-blue-100/80">
            Liczba uczestników: <span class="font-semibold text-white">{shown.participant_target}</span>
          </p>
          {deadline && (
            <p class="mb-4 text-sm text-blue-100/80">
              {effectiveStatus === "closed" ? "Termin: " : "Zakończy się automatycznie: "}
              <span class="font-semibold text-white">{deadline}</span>
            </p>
          )}
          {results ? (
            <StudyResults studyId={shown.id} initial={results} client:load />
          ) : (
            <>
              <h2 class="mb-2 text-sm text-blue-100/80">Warianty</h2>
              <ol class="space-y-2">
                {variants.map((variant, index) => (
                  <li class="rounded-lg border border-white/20 bg-white/5 px-3 py-2 text-sm">
                    <span class="mb-1 block text-xs text-blue-100/60">Wariant {index + 1}</span>
                    <span class="break-words whitespace-pre-wrap">{variant.content}</span>
                  </li>
                ))}
              </ol>
            </>
          )}
          {error && (
            <div class="mt-6">
              <ServerError message={error} />
            </div>
          )}
          {shown.status === "draft" ? (
            <div class="mt-6">
              <a
                href={`/studies/${encodeURIComponent(shown.id)}/edit`}
                class="mb-3 flex w-full items-center justify-center gap-2 rounded-lg border border-white/20 px-4 py-2 font-medium text-white transition-colors hover:bg-white/10"
              >
                <Pencil className="size-4" aria-hidden="true" />
                Edytuj
              </a>
              <StartStudyButton studyId={shown.id} participantTarget={shown.participant_target} client:load />
            </div>
          ) : (
            <>
              <h2 class="mt-6 mb-2 text-sm text-blue-100/80">Linki do głosowania ({urls.length})</h2>
              <LinkList urls={urls} client:load />
              {effectiveStatus === "active" && (
                <div class="mt-6">
                  <CloseStudyButton studyId={shown.id} client:load />
                </div>
              )}
            </>
          )}
          <p class="mt-6 text-center text-sm text-blue-100/60">
            <a href="/dashboard" class="text-purple-300 hover:underline">
              Wróć do panelu
            </a>
          </p>
        </>
      )}
    </div>
  </div>
</Layout>
