---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { STATUS_LABELS } from "@/lib/study-status";
import { progressLabel } from "@/lib/study-progress";

// list_author_studies is scoped to the caller in the database and returns the effective status
// plus link counts, which authors cannot read from study_links (contract-surfaces.md#anonymity-rule).
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data: studies, error: studiesError } = supabase
  ? await supabase.rpc("list_author_studies")
  : { data: [], error: null };

// Set by POST /api/studies/<id>/delete. Only the flag is read; nothing from the URL is rendered.
const deleted = Astro.url.searchParams.get("deleted") === "1";
---

<Layout title="Twoje badania">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <Topbar />

    <main class="mx-auto w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Twoje badania
        </h1>
        <a
          href="/studies/new"
          class="inline-block rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
        >
          Nowe badanie
        </a>
      </div>

      {deleted && (
        <p class="mb-4 rounded-lg border border-white/20 bg-white/5 px-3 py-2 text-sm text-blue-100/90" role="status">
          Badanie zostało usunięte.
        </p>
      )}

      {studiesError ? (
        <p class="text-sm text-red-300">Nie udało się wczytać badań.</p>
      ) : studies.length > 0 ? (
        <ul class="space-y-2">
          {studies.map((study) => (
            <li>
              <a
                href={`/studies/${study.id}`}
                class="flex flex-col gap-1 rounded-lg border border-white/20 bg-white/5 px-3 py-2 text-sm transition-colors hover:bg-white/10 sm:flex-row sm:items-center sm:justify-between sm:gap-4"
              >
                <span class="truncate">{study.title}</span>
                <span class="shrink-0 text-xs text-blue-100/60">
                  {STATUS_LABELS[study.status]} · {progressLabel(study)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-blue-100/50">Nie masz jeszcze żadnych badań.</p>
      )}
    </main>
  </div>
</Layout>
