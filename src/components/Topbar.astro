---
import { buttonVariants } from "@/components/ui/button";

const { user } = Astro.locals;
const isDashboard = Astro.url.pathname.replace(/\/+$/, "") === "/dashboard";
---

<header class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-xl border border-border bg-card px-4 py-2 text-sm text-foreground backdrop-blur-xl">
  <a
    href="/"
    class="shrink-0 rounded-md bg-linear-to-r from-brand-1 via-brand-2 to-brand-3 bg-clip-text text-xl font-bold text-transparent outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
  >
    ThisOrThat
  </a>
  <nav aria-label="Konto i nawigacja" class="flex max-w-full min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
    {user ? (
      <>
        <a
          href="/dashboard"
          aria-current={isDashboard ? "page" : undefined}
          class:list={[
            buttonVariants({ variant: "ghost", size: "sm" }),
            "text-link aria-[current=page]:bg-secondary aria-[current=page]:text-foreground",
          ]}
        >
          Twoje badania
        </a>
        <span class="max-w-full min-w-0 truncate text-muted-foreground" title={user.email}>
          {user.email}
        </span>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class:list={[buttonVariants({ variant: "ghost", size: "sm" }), "text-link"]}>
            Wyloguj
          </button>
        </form>
      </>
    ) : (
      <>
        <span class="sr-only">Nie zalogowano</span>
        <a href="/auth/signin" class:list={[buttonVariants({ variant: "ghost", size: "sm" }), "text-link"]}>
          Zaloguj się
        </a>
        <a href="/auth/signup" class:list={buttonVariants({ variant: "default", size: "sm" })}>
          Załóż konto
        </a>
      </>
    )}
  </nav>
</header>
